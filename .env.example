# Copie para .env antes de rodar: cp .env.example .env
# Os valores abaixo são os do docker-compose (só para desenvolvimento).

# Endereço público do app, usado no link curto
APP_URL="http://localhost:3000"

# PostgreSQL
DATABASE_URL="postgresql://encurtai:encurtai@localhost:5432/encurtai"

# Redis: o docker-compose sobe uma API igual à do Upstash.
# Para usar um banco do Upstash, cole a URL e o token da seção REST API dele.
UPSTASH_REDIS_REST_URL="http://localhost:8079"
UPSTASH_REDIS_REST_TOKEN="dev-token"

# Auth.js
# Gere um valor com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# OAuth App do GitHub (Settings > Developer settings > OAuth Apps > New OAuth App)
# Homepage URL: http://localhost:3000
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
